# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=forti-member-app
DB_USER=forti-member-app
DB_PASS=change-me

# App
PORT=5031
JWT_SECRET=change-me-in-production
FRONTEND_URL=https://forti-member-app.kaitensoftware.com
NODE_ENV=production

# Admin seed (used by deploy.sh fresh / db-reset)
