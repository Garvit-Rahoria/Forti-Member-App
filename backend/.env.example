# SMTP (OTP + transactional email) — also storable as MAIL_* in system_settings
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="FORTI Portal" <noreply@example.com>
